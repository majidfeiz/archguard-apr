FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /usr/local/bin/uv
WORKDIR /opt/archguard
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-editable --python /usr/local/bin/python
RUN groupadd --gid 10001 validator && useradd --uid 10001 --gid validator --create-home validator
ENV PATH=/opt/archguard/.venv/bin:$PATH PYTHONPATH=/workspace/src PYTHONDONTWRITEBYTECODE=1
USER validator
WORKDIR /workspace
ENTRYPOINT ["python"]
