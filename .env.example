ARCHGUARD_ENVIRONMENT=development
ARCHGUARD_LOG_LEVEL=INFO
ARCHGUARD_JSON_LOGGING=false
ARCHGUARD_EXECUTION_TIMEOUT=300
ARCHGUARD_RANDOM_SEED=0
ARCHGUARD_PROVIDER_EXECUTION_ENABLED=false
ARCHGUARD_ANALYSIS__MAX_FILE_BYTES=1048576
ARCHGUARD_ANALYSIS__INCLUDE_HIDDEN=false
ARCHGUARD_ANALYSIS__SYMLINK_POLICY=skip
ARCHGUARD_ANALYSIS__SOURCE_ROOTS=[]
ARCHGUARD_ANALYSIS__FAIL_FAST=false
ARCHGUARD_ANALYSIS__STRICT=false
# Provider API credentials are read only from the environment. Never commit real values.
OPENAI_API_KEY=replace-at-runtime
ANTHROPIC_API_KEY=replace-at-runtime
OPENAI_MODEL=replace-with-an-allowlisted-model
ANTHROPIC_MODEL=replace-with-an-allowlisted-model
ARCHGUARD_RUN_LIVE_OPENAI_TESTS=0
ARCHGUARD_RUN_LIVE_ANTHROPIC_TESTS=0
ARCHGUARD_ACKNOWLEDGE_PROVIDER_COST=0
